# LaunchBoard Backend

## Environment Variables

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/launchboard

# AI Classification
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-2.0-flash
AI_PROVIDER=gemini

# Admin Authentication
ADMIN_API_KEY=your-secure-admin-key-here

# Optional: Adzuna API (free tier - https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: FindWork API (free tier - https://findwork.dev/developers/)
FINDWORK_API_KEY=

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000","https://launchboard.vercel.app"]

# Collection Settings
COLLECTION_BATCH_SIZE=50
CLASSIFICATION_CONFIDENCE_HIGH=0.85
CLASSIFICATION_CONFIDENCE_MEDIUM=0.65
